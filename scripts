// ==UserScript==
// @name         youTube Video Speed
// @namespace
// @version      2025-12-16
// @description
// @author       You
// @match        *://www.youtube.com/*
// @icon
// @grant        none
// @run-at       document-idle
// ==/UserScript==

setTimeout(function() {
    console.log('setup');
    if (document.location.pathname == '/watch') {
        console.log('in watch');
        initWatch();
    } else
    if (document.location.pathname.includes('/shorts/')) {
        console.log('in shorts');
        initShorts();
    } else {
        console.log('no match found');
    }
    console.log('done');
}, 1000);

function initShorts() {
    setInterval(() => {
        createDiv(1);
    }, 1000);
    appendListener();
}

function initWatch() {
    setInterval(() => {
        createDiv(0);
    }, 1000);
    appendListener();
}

function appendListener() {
    document.addEventListener('keydown', (e) => {
        if (e.keyCode == 107) {
            document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate += 0.25;
        }
        if (e.keyCode == 109) {
            document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate -= 0.25;
        }
        updateDiv();
    });
}

function createDiv(value) {
    if (document.getElementById('mySpeed')) {
        document.getElementById('mySpeed').remove();
    }
    var vsr = document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate;
    var ddiv = document.createElement('div');
    ddiv.id = 'mySpeed';
    ddiv.style.color = 'orange';

    if (value == 1) {
        document.getElementsByTagName('yt-shorts-video-title-view-model')[0].appendChild(ddiv);
    } else if (value == 0) {
        document.getElementById('title').appendChild(ddiv);
    } else {}
    updateDiv();
}

function updateDiv() {
    document.getElementById('mySpeed').innerText = document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate + 'x <- videoSpeed. Use numpad\'s \'+\' to increase speed, \'-\' to decrease speed. Step is 0.25';;
}
