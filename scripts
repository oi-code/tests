// ==UserScript==
// @name         youTube Video Speed
// @namespace
// @version      2025-12-16
// @description
// @author       You
// @match        *://www.youtube.com/*
// @icon
// @grant        none
// @run-at       document-idle
// ==/UserScript==

setTimeout(() => {
    console.log('setup');
    setInterval(() => {
        if (document.location.pathname == '/watch') {
            createDiv(0);
        } else if (document.location.pathname.includes('/shorts/')) {
            createDiv(1);
        } else {}
    }, 1000);
    document.getElementById('logo').setAttribute('customspeed', 1);
    console.log('done');
}, 1000);


function keyHandler(event) {
    //let curDiv = document.getElementById('mySpeed');
    let logo = document.getElementById('logo');
    let players = document.getElementsByClassName('video-stream html5-main-video');
    Array.from(players).forEach((element) => {
        if (event.keyCode == 107) {
            element.playbackRate += 0.25;
        }
        if (event.keyCode == 109) {
            element.playbackRate -= 0.25;
        }
        //curDiv.title = element.playbackRate;

    });
    logo.setAttribute('customspeed', players[0].playbackRate);
    updateDiv();
}

function createDiv(value) {
    let div = document.getElementById('mySpeed');
    if (div) {
        div.remove();
        document.removeEventListener('keydown', keyHandler);
    }
    div = document.createElement('div');
    div.id = 'mySpeed';
    div.style.color = 'orange';
    if (value == 0) {
        document.getElementById('title').appendChild(div);
    } else if (value == 1) {
        document.getElementsByTagName('yt-shorts-video-title-view-model')[0].appendChild(div);
    } else {}
    document.addEventListener('keydown', keyHandler);
    updateDiv();
}

function updateDiv() {
    //let currentPage=document.location.pathname.includes('watch')?'watch':document.location.pathname.includes('shorts')?'shorts':'none';
    let curDiv = document.getElementById('mySpeed');
    let cv = parseFloat(document.getElementById('logo').getAttribute('customspeed'));
    let players = document.getElementsByClassName('video-stream html5-main-video');
    Array.from(players).forEach((element) => {
        element.playbackRate = cv;
    });
    curDiv.innerText = players[0].playbackRate + 'x <- videoSpeed. Use numpad\'s \'+\' to increase speed, \'-\' to decrease speed. Step is 0.25';
}
