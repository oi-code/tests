// ==UserScript==
// @name         youTube Video Speed
// @namespace
// @version      2025-12-16
// @description
// @author       You
// @match        *://www.youtube.com/*
// @icon
// @grant        none
// @run-at       document-idle
// ==/UserScript==

setTimeout(() => {
    console.log('setup');
    setInterval(() => {
        let curDiv = document.getElementById('mySpeed');
        if (curDiv) {
            if (document.location.pathname == '/watch') {
                if (curDiv.title == 1) {
                    curDiv.remove();
                    document.removeEventListener('keydown', keyHandler);
                    console.log('removed 1');
                }
                createDiv(0);
                document.addEventListener('keydown', keyHandler);
            } else if (document.location.pathname.includes('/shorts/')) {
                if (curDiv.title == 0) {
                    curDiv.remove();
                    document.removeEventListener('keydown', keyHandler);
                    console.log('removed 0');
                }
                createDiv(1);
                document.addEventListener('keydown', keyHandler);
            } else {}
        } else {
            if (document.location.pathname == '/watch') {
                createDiv(0);
                document.addEventListener('keydown', keyHandler);
            } else if (document.location.pathname.includes('/shorts/')) {
                createDiv(1);
                document.addEventListener('keydown', keyHandler);
            } else {}
        }
    }, 1000);
    console.log('done');
}, 1000);


function keyHandler(e) {
    Array.from(document.getElementsByClassName('video-stream html5-main-video')).forEach((element) => {
        if (e.keyCode == 107) {
            element.playbackRate += 0.25;
        }
        if (e.keyCode == 109) {
            element.playbackRate -= 0.25;
        }
    });
    updateDiv();
}

function createDiv(value) {
    if (document.getElementById('mySpeed')) {
        document.getElementById('mySpeed').remove();
    }
    let vsr = document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate;
    let ddiv = document.createElement('div');
    ddiv.id = 'mySpeed';
    ddiv.style.color = 'orange';
    ddiv.title = value;

    if (value == 1) {
        document.getElementsByTagName('yt-shorts-video-title-view-model')[0].appendChild(ddiv);
    } else if (value == 0) {
        document.getElementById('title').appendChild(ddiv);
    } else {}
    updateDiv();
}

function updateDiv() {
    document.getElementById('mySpeed').innerText = document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate + 'x <- videoSpeed. Use numpad\'s \'+\' to increase speed, \'-\' to decrease speed. Step is 0.25';;
}
