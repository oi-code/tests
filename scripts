// ==UserScript==
// @name         youTube Video Speed
// @namespace
// @version      2025-12-16
// @description
// @author       You
// @match        *://www.youtube.com/*
// @icon
// @grant        none
// @run-at       document-idle
// ==/UserScript==

setTimeout(function() {
    console.log('setup');
    init();
    console.log('done');
}, 1000);

function init() {
    setInterval(() => {
        if (document.location.pathname == '/watch') {
            createDiv();
        }
    }, 2500);
    appendListener();
}

function appendListener() {
    document.addEventListener('keydown', (e) => {
        if (e.keyCode == 107) {
            document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate += 0.25;
        }
        if (e.keyCode == 109) {
            document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate -= 0.25;
        }
        updateDiv();
    });
}

function createDiv() {
    var vsr = document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate;
    var ddiv = document.createElement('div');
    ddiv.id = 'mySpeed';
    ddiv.style.color = 'orange';
    document.getElementById('title').appendChild(ddiv);
    updateDiv();
}

function updateDiv() {
    document.getElementById('mySpeed').innerText = document.getElementsByClassName('video-stream html5-main-video')[0].playbackRate + 'x <- videoSpeed. Use numpad\'s \'+\' to increase speed, \'-\' to decrease speed. Step is 0.25';;
}
